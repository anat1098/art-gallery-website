generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Auth / Users
// ============================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)

  phone     String?
  addresses Address[]
  orders    Order[]
  accounts  Account[]
  sessions  Session[]
  messages  ContactMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  phone      String?
  country    String
  city       String
  street     String
  postalCode String
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Catalog: shared taxonomy
// ============================================================

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  nameHe    String?
  order     Int        @default(0)
  artworks  Artwork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medium {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  nameHe   String?
  order    Int       @default(0)
  artworks Artwork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Artworks (Prints + Originals share a base model)
// ============================================================

enum ArtworkType {
  PRINT
  ORIGINAL
}

model Artwork {
  id          String      @id @default(cuid())
  type        ArtworkType
  slug        String      @unique
  title       String
  titleHe     String?
  description String?     @db.Text
  descriptionHe String?   @db.Text
  materials   String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  mediumId   String?
  medium     Medium?   @relation(fields: [mediumId], references: [id])

  isFeatured Boolean @default(false)
  isNewArrival Boolean @default(false)
  isPublished  Boolean @default(false)

  images ArtworkImage[]

  // Original-only fields
  originalPrice      Decimal?  @db.Decimal(10, 2)
  originalWidthCm    Decimal?  @db.Decimal(6, 2)
  originalHeightCm   Decimal?  @db.Decimal(6, 2)
  yearCreated        Int?
  isSold             Boolean   @default(false)
  shippingTimeNote   String?

  // Print-only relations
  printSizes    PrintSize[]
  frameOptions  FrameOption[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isPublished])
  @@index([isFeatured])
}

model ArtworkImage {
  id        String  @id @default(cuid())
  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  url        String
  thumbnailUrl String?
  alt        String?
  kind       String? // main | detail | angle | framed | unframed | lifestyle
  isPrimary  Boolean @default(false)
  order      Int     @default(0)

  createdAt DateTime @default(now())
}

// A print size option, e.g. A4 / A3 / A2, with its own price + inventory
model PrintSize {
  id        String  @id @default(cuid())
  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  label     String // "A4", "A3", "30x40cm", etc.
  widthCm   Decimal @db.Decimal(6, 2)
  heightCm  Decimal @db.Decimal(6, 2)
  price     Decimal @db.Decimal(10, 2)
  inventory Int     @default(0)
  order     Int     @default(0)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Frame / no-frame option per artwork, with a price delta
model FrameOption {
  id        String  @id @default(cuid())
  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  label      String // "No Frame", "Oak Frame", "Black Frame"
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  isDefault  Boolean @default(false)

  orderItems OrderItem[]
}

// ============================================================
// Orders
// ============================================================

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  PRINTED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProviderType {
  STRIPE
  PAYPAL
  APPLE_PAY
  BIT
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  email     String
  firstName String
  lastName  String
  phone     String
  country   String
  city      String
  street    String
  postalCode String
  shippingNotes String? @db.Text
  orderNotes    String? @db.Text

  currency      String  @default("USD")
  subtotal      Decimal @db.Decimal(10, 2)
  shippingCost  Decimal @db.Decimal(10, 2) @default(0)
  total         Decimal @db.Decimal(10, 2)

  items    OrderItem[]
  payments Payment[]

  trackingNumber String?
  trackingUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id])

  printSizeId String?
  printSize   PrintSize? @relation(fields: [printSizeId], references: [id])

  frameOptionId String?
  frameOption   FrameOption? @relation(fields: [frameOptionId], references: [id])

  titleSnapshot String
  unitPrice     Decimal @db.Decimal(10, 2)
  quantity      Int     @default(1)
  lineTotal     Decimal @db.Decimal(10, 2)
}

model Payment {
  id       String              @id @default(cuid())
  orderId  String
  order    Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider PaymentProviderType
  status   PaymentStatus       @default(PENDING)

  providerRef String? // external charge/session id
  amount      Decimal @db.Decimal(10, 2)
  currency    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Shipping
// ============================================================

model ShippingRule {
  id      String  @id @default(cuid())
  region  String  @unique // "IL", "US", "EU", "CA", "AU", "ROW"
  label   String
  cost    Decimal @db.Decimal(10, 2)
  estimatedDaysMin Int?
  estimatedDaysMax Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Site content / settings (admin-editable, no-code)
// ============================================================

model Setting {
  key       String @id
  value     Json
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id      String  @id @default(cuid())
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  name    String
  email   String
  subject String
  message String @db.Text
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
}

model Currency {
  code    String  @id // "USD", "ILS", "EUR", "GBP", "CAD", "AUD"
  symbol  String
  label   String
  rateToUsd Decimal @db.Decimal(10, 6) @default(1)
  isDefault Boolean @default(false)
}
